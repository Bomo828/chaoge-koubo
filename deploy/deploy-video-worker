#!/usr/bin/env bash
set -euo pipefail

ARCHIVE="${1:-}"
RELEASE_SHA="${2:-}"
APP_ROOT="/opt/merchant-studio"
APP_DIR="${APP_ROOT}/video-worker"
NEW_DIR="${APP_ROOT}/video-worker-new"
BACKUP_DIR="${APP_ROOT}/video-worker-backup"
FAILED_DIR="${APP_ROOT}/video-worker-failed"
SERVICE="merchant-video-worker.service"

fail() {
  echo "Video worker deployment failed: $*" >&2
  exit 1
}

[[ -n "${ARCHIVE}" ]] || fail "archive path is required"
[[ "${RELEASE_SHA}" =~ ^[0-9a-f]{40}$ ]] || fail "release SHA is invalid"

resolved_archive="$(realpath -- "${ARCHIVE}")"
[[ "${resolved_archive}" == "/tmp/merchant-video-worker-${RELEASE_SHA}.tar.gz" ]] || fail "archive path is not allowed"
[[ -f "${resolved_archive}" ]] || fail "archive does not exist"
[[ "$(stat -c '%U' "${resolved_archive}")" == "merchantdeploy" ]] || fail "archive owner is invalid"

exec 9>"/var/lock/merchant-video-worker-deploy.lock"
flock -n 9 || fail "another video worker deployment is already running"

while IFS= read -r entry; do
  [[ "${entry}" != /* ]] || fail "archive contains an absolute path"
  [[ "${entry}" != ".." && "${entry}" != ../* && "${entry}" != */../* ]] || fail "archive contains a parent path"
done < <(tar -tzf "${resolved_archive}")

rm -rf -- "${NEW_DIR}" "${FAILED_DIR}"
mkdir -p "${NEW_DIR}"
tar -xzf "${resolved_archive}" -C "${NEW_DIR}"

[[ -f "${NEW_DIR}/main.py" ]] || fail "main.py is missing from the release"
[[ -f "${NEW_DIR}/requirements.txt" ]] || fail "requirements.txt is missing from the release"
[[ -f "${NEW_DIR}/template-registry.json" ]] || fail "template registry is missing from the release"
[[ -f "${NEW_DIR}/remotion-worker/package.json" ]] || fail "Remotion worker is missing from the release"
[[ -d "${NEW_DIR}/remotion-worker/node_modules" ]] || fail "Remotion production dependencies are missing"
[[ "$(cat "${NEW_DIR}/RELEASE_SHA")" == "${RELEASE_SHA}" ]] || fail "release SHA does not match"

# Runtime credentials and the Python environment are server-owned. Preserve
# them across immutable source releases instead of putting secrets in GitHub.
[[ -f "${APP_DIR}/.env" ]] || fail "existing worker environment is missing"
[[ -d "${APP_DIR}/.venv" ]] || fail "existing worker Python environment is missing"
cp -a "${APP_DIR}/.env" "${NEW_DIR}/.env"
cp -a "${APP_DIR}/.venv" "${NEW_DIR}/.venv"

rollback() {
  local exit_code=$?
  trap - ERR
  echo "Video worker deployment failed; rolling back to the previous release." >&2
  systemctl stop "${SERVICE}" 2>/dev/null || true
  if [[ -d "${APP_DIR}" ]]; then
    mv "${APP_DIR}" "${FAILED_DIR}" 2>/dev/null || true
  fi
  if [[ -d "${BACKUP_DIR}" ]]; then
    mv "${BACKUP_DIR}" "${APP_DIR}"
    systemctl start "${SERVICE}" 2>/dev/null || true
  fi
  rm -f -- "${resolved_archive}"
  exit "${exit_code}"
}
trap rollback ERR

systemctl stop "${SERVICE}"
rm -rf -- "${BACKUP_DIR}"
mv "${APP_DIR}" "${BACKUP_DIR}"
mv "${NEW_DIR}" "${APP_DIR}"

chown -R root:root "${APP_DIR}"
chmod -R a+rX "${APP_DIR}"
mkdir -p "${APP_DIR}/remotion-worker/node_modules/.cache" "${APP_DIR}/remotion-worker/node_modules/.remotion"
chown -R merchant-studio:merchant-studio \
  "${APP_DIR}/remotion-worker/node_modules/.cache" \
  "${APP_DIR}/remotion-worker/node_modules/.remotion"
chmod 600 "${APP_DIR}/.env"

systemctl start "${SERVICE}"

healthy=false
for _ in $(seq 1 40); do
  if curl -fsS http://127.0.0.1:8790/health >/dev/null && systemctl is-active --quiet "${SERVICE}"; then
    healthy=true
    break
  fi
  sleep 1
done
[[ "${healthy}" == "true" ]] || fail "health check did not pass"

trap - ERR
rm -f -- "${resolved_archive}"
rm -rf -- "${FAILED_DIR}"
echo "Merchant video worker ${RELEASE_SHA} deployed successfully."
