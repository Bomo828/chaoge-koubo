# 本地开发：复制为 .env.local 后填写。不要提交真实密钥。
APP_DATA_DIR=.data
ENABLE_DEMO_ACCOUNT=true
DEMO_USERNAME=demo
DEMO_PASSWORD=123456
# 生产环境必须修改管理员账号和密码。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin123456!

LK888_API_KEY=your_api_key_here
LK888_API_BASE_URL=https://api.lk888.ai
# 可选：用于加密后台保存的 AI Key；留空时会在 APP_DATA_DIR 自动生成服务器专用密钥文件。
AI_CREDENTIALS_ENCRYPTION_KEY=
# 会员积分换算：默认 1 算力 = 100 积分。最终扣点以平台任务 cost 为准。
AI_POINTS_PER_CREDIT=100

# 抖音公开账号监控。生产环境建议自托管兼容采集服务，避免依赖公共演示接口。
DOUYIN_PROFILE_API_BASE_URL=https://www.iesdouyin.com
DOUYIN_COLLECTOR_BASE_URL=https://douyin.wtf

# 蝉镜真人视频对口型（服务端专用，禁止暴露到浏览器）
CHANJING_BASE_URL=https://open-api.chanjing.cc
CHANJING_APP_ID=your_app_id_here
CHANJING_SECRET_KEY=your_secret_key_here
# 声音克隆需要公网 HTTPS 音频；本地上传由该服务中转为临时公网地址。
VOICE_SAMPLE_RELAY_BASE_URL=https://api.chaogeai.top
# 公网视频处理服务；本地开发默认也会使用该地址。
NEXT_PUBLIC_VIDEO_WORKER_URL=https://api.chaogeai.top/video-worker
# 仅服务器使用；必须与视频处理服务 VIDEO_WORKER_ADMIN_TOKEN 保持一致。
VIDEO_WORKER_ADMIN_TOKEN=replace-with-a-long-random-secret

# 腾讯云 MPS：AI 导演的干净成片在云端完成裁切、拼接、静音与口播覆盖。
# SecretId / SecretKey 只允许配置在服务端。COS 存储桶需给 MPS 服务角色读写权限。
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_MPS_COS_BUCKET=
TENCENT_MPS_COS_REGION=ap-guangzhou
TENCENT_MPS_INPUT_PREFIX=ai-director/input
TENCENT_MPS_OUTPUT_PREFIX=ai-director/output
# 可选：把模板注册表 JSON 放到腾讯云 COS 后填写此地址。读取失败时自动回退到随服务发布的首个模板。
VIDEO_TEMPLATE_REGISTRY_URL=
VIDEO_TEMPLATE_REGISTRY_CACHE_SECONDS=300
