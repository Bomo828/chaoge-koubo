# 本地开发：复制为 .env.local 后填写。不要提交真实密钥。
APP_DATA_DIR=.data
ENABLE_DEMO_ACCOUNT=false
DEMO_USERNAME=demo
DEMO_PASSWORD=replace-with-a-long-random-password
# 生产环境必须修改管理员账号和密码。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-different-long-random-password

LK888_API_KEY=your_api_key_here
LK888_API_BASE_URL=https://api.lk888.ai
# 可选：用于加密后台保存的 AI Key；留空时会在 APP_DATA_DIR 自动生成服务器专用密钥文件。
AI_CREDENTIALS_ENCRYPTION_KEY=
# 会员积分换算：默认 1 算力 = 100 积分。最终扣点以平台任务 cost 为准。
AI_POINTS_PER_CREDIT=100

# 抖音公开账号监控。生产环境建议自托管兼容采集服务，避免依赖公共演示接口。
DOUYIN_PROFILE_API_BASE_URL=https://www.iesdouyin.com
DOUYIN_COLLECTOR_BASE_URL=https://douyin.wtf

# 蝉镜真人视频对口型（服务端专用，禁止暴露到浏览器）
CHANJING_BASE_URL=https://open-api.chanjing.cc
CHANJING_APP_ID=your_app_id_here
CHANJING_SECRET_KEY=your_secret_key_here
# 声音克隆需要公网 HTTPS 音频；本地上传由该服务中转为临时公网地址。
VOICE_SAMPLE_RELAY_BASE_URL=https://media.example.com
# 公网视频处理服务；本地开发默认也会使用该地址。
NEXT_PUBLIC_VIDEO_WORKER_URL=/video-worker
VIDEO_WORKER_UPSTREAM_URL=http://10.0.0.20/video-worker
# 可选：仅在迁移旧产物期间允许从旧视频节点下载；稳定后应删除。
LEGACY_VIDEO_WORKER_URL=
# 仅服务器使用；必须与视频处理服务 VIDEO_WORKER_ADMIN_TOKEN 保持一致。
VIDEO_WORKER_ADMIN_TOKEN=replace-with-a-long-random-secret

# 腾讯云 MPS：AI 导演的干净成片在云端完成裁切、拼接、静音与口播覆盖。
# SecretId / SecretKey 只允许配置在服务端。COS 存储桶需给 MPS 服务角色读写权限。
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_MPS_COS_BUCKET=
TENCENT_MPS_COS_REGION=ap-guangzhou
TENCENT_MPS_INPUT_PREFIX=ai-director/input
TENCENT_MPS_OUTPUT_PREFIX=ai-director/output
# 逗号分隔，仅填写实际允许浏览器直传的 Origin，不要带路径。
COS_CORS_ORIGINS=https://studio.example.com,http://127.0.0.1:3012,http://localhost:3012
# 可选：把模板注册表 JSON 放到腾讯云 COS 后填写此地址。读取失败时自动回退到随服务发布的首个模板。
VIDEO_TEMPLATE_REGISTRY_URL=
VIDEO_TEMPLATE_REGISTRY_CACHE_SECONDS=300

# 公开图片、封面和预览视频 CDN。留空时自动使用站内 /media 与 /template-covers。
# CDN 回源应指向 COS 的 public 前缀；不要用于会员私有资产。
NEXT_PUBLIC_MEDIA_CDN_BASE_URL=

# 微信支付 APIv3（普通商户直连 Native 支付，仅服务端使用）
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
# 推荐填写服务器绝对路径，私钥文件不要放进 Git 仓库。
WECHAT_PAY_PRIVATE_KEY_PATH=/etc/merchant-studio/secrets/apiclient_key.pem
# 微信支付平台证书或微信支付公钥，二选一配置对应文件路径。
WECHAT_PAY_PLATFORM_CERT_PATH=/etc/merchant-studio/secrets/wechatpay_platform_cert.pem
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
# 可选；填写后会严格校验回调/响应头中的 Wechatpay-Serial。
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://studio.example.com/api/pay/wechat/notify
